[
  {
    "name": "UPSC Written Results",
    "url": "https://cms.upsc.gov.in/results/examination-written-results/",
    "allowed_domains": [
      "upsc.gov.in",
      "cms.upsc.gov.in"
    ],
    "pattern": "result|written|merit|final|\\.pdf$",
    "fallback_urls": [
      "https://cms.upsc.gov.in/results/examination-final-results/"
    ]
  },
  {
    "name": "SSC Results Notice Board",
    "url": "https://sscnr.nic.in/newlook/site/Whatsnew.html",
    "allowed_domains": [
      "sscnr.nic.in"
    ],
    "pattern": "result|merit|final|shortlist|selection"
  },
  {
    "name": "Rajasthan State Recruitment Results",
    "url": "https://rpsc.rajasthan.gov.in/",
    "allowed_domains": [
      "rpsc.rajasthan.gov.in"
    ],
    "pattern": "result|merit|final|selection"
  }
]
